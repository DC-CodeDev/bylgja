{
  "name": "bylgja",
  "version": "0.1.0",
  "private": true,
  "description": "Yggdrasil Suite motion primitives for deterministic spring-based animation.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loops/*.css": "./dist/loops/*.css",
    "./tokens/*.css": "./dist/tokens/*.css",
    "./variants/*.css": "./dist/variants/*.css",
    "./variants/tooltip.css": "./dist/variants/tooltip.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0-0",
    "react-dom": "^18.0.0 || ^19.0.0-0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.5.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy:variant-css",
    "copy:variant-css": "node ./scripts/copy-variant-css.mjs",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "prepare": "echo 'prebuilt dist committed to git — no build step needed on install'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "node ./scripts/verify-package.mjs"
  }
}
