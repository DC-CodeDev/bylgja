{
  "name": "bylgja",
  "version": "0.1.0",
  "private": true,
  "description": "Yggdrasil Suite motion primitives for deterministic spring-based animation.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./variants/*.css": "./src/variants/*.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/variants/*.css",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0-0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.5.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
